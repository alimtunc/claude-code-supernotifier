{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      "value-builtin",
      "value-external",
      ["value-parent", "value-sibling", "value-index"],
      ["type-builtin", "type-external", "type-parent", "type-sibling", "type-index"]
    ]
  },
  "ignorePatterns": ["dist/", "out/", "coverage/", "node_modules/", "docs/", "*.vsix", "pnpm-lock.yaml"]
}
